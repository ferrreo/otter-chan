# Copy to .env for local `docker compose up`; in Coolify put these in the resource's Environment tab.
# name:token pairs. "device" is the robot; every other name is a Grok bot / client identity.
# Generate tokens with: openssl rand -hex 24
OTTER_TOKENS=device:CHANGE_ME_DEVICE,grok-alpha:CHANGE_ME_BOT_A,grok-beta:CHANGE_ME_BOT_B,admin:CHANGE_ME_ADMIN
# Meta Model API key. The Muse Code plan key from ~/.config/muse/auth.json ("api_key") works here.
META_MODEL_API_KEY=
OTTER_LLM_MODEL=muse-spark-1.3-contributor
OTTER_LLM_REASONING=minimal
OTTER_NAME=Tarquin
OTTER_WAKE_PHRASES=tarquin,hey tarquin,ok tarquin
# TTS engine: piper (native, ~20x real time on CPU) or vox (Audio8 clone, needs a strong GPU to be quick)
OTTER_TTS_ENGINE=piper
# piper voices shipped in the image: en_GB-alan-medium, en_GB-northern_english_male-medium
OTTER_PIPER_MODEL=/opt/piper/voices/en_GB-northern_english_male-medium.onnx
OTTER_PIPER_SPEED=1.0
OTTER_VOX_VOICE=tarquin
# GPU (Intel/AMD Vulkan through /dev/dri): default. CPU only: OTTER_VOX_ARGS=--cpu --cpu-threads 8
OTTER_VOX_ARGS=--backend vulkan --gpu auto
# host GIDs owning /dev/dri/renderD* and /dev/dri/card* (getent group render video)
RENDER_GID=992
VIDEO_GID=44
OTTER_STT_MODEL=tdt_ctc-110m
OTTER_FOLLOWUP=true
