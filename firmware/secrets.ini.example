; Copy to secrets.ini (gitignored). These become compile-time defaults;
; anything saved through the captive portal / serial console overrides them.
[env:otter]
build_flags =
    ${env:otter.build_flags}
    -DOTTER_WIFI_SSID=\"MyWiFi\"
    -DOTTER_WIFI_PASS=\"hunter2\"
    -DOTTER_SERVER_URL=\"wss://bot.ferreo.dev/ws/device\"
    -DOTTER_DEVICE_TOKEN=\"change-me-device-token\"
